{
  "name": "@capyra/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 5090 --inspector-port 9232",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "types": "wrangler types worker-configuration.d.ts --env-file /dev/null",
    "typecheck": "tsc --project tsconfig.json --noEmit",
