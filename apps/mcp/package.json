  "dependencies": {
    "@capyra/contracts": "file:../../contracts/typescript",
    "@capyra/integration-core": "file:../../packages/capyra-integration-core",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.127.1"
  }
}
