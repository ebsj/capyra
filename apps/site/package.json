{
  "name": "@capyra/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 3001",
    "dev:next": "next dev --webpack",
    "build": "vinext build",
    "build:next": "next build",
    "start": "vinext start --port 3001",
    "deploy": "vinext build && vinext-cloudflare deploy --skip-build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "^16.3.3",
    "next-intl": "^4.9.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.7",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "^5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@opentelemetry/core": "2.9.0",
    "protobufjs": "7.6.5",
    "@opentelemetry/otlp-transformer": {
      "protobufjs": "8.6.5"
    },
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
