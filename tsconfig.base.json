{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@capyra/contracts": ["./contracts/typescript/src/index.ts"],
      "@capyra/integration-core": ["./packages/capyra-integration-core/src/index.ts"]
    }
  }
}
