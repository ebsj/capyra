{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShortVideoAnalysisReport",
  "type": "object",
  "required": [
    "source",
    "catalog_version",
    "selected_skill_ids",
    "transcript",
    "executed_skills",
    "warnings"
  ],
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "source_type",
        "source_label",
        "duration_seconds",
        "width",
        "height",
        "fps",
        "has_audio",
        "ingest_status"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["public_url", "public_url_best_effort", "file_upload", "owned_asset", "connected_media"]
        },
        "source_label": { "type": "string" },
        "source_url": { "type": ["string", "null"] },
        "canonical_url": { "type": ["string", "null"] },
        "platform": {
          "anyOf": [
            { "type": "string", "enum": ["instagram_reels", "youtube_shorts", "tiktok"] },
            { "type": "null" }
          ]
        },
        "content_id": { "type": ["string", "null"] },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "fps": { "type": "number", "minimum": 0 },
        "has_audio": { "type": "boolean" },
        "ingest_status": { "type": "string", "enum": ["downloaded", "uploaded", "partial"] },
        "artifact_directory": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "catalog_version": { "type": "string" },
    "transcript": { "$ref": "#/$defs/transcript" },
    "selected_skill_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/analysis_skill_id" }
    },
    "executed_skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/executed_skill_result" }
    },
    "overall_score": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "analysis_skill_id": {
      "type": "string",
      "enum": ["content_strategy", "filming", "editing", "audio_music", "compliance"]
    },
    "executed_skill_status": {
      "type": "string",
      "enum": ["completed", "insufficient_evidence", "failed"]
    },
    "evidence_item": {
      "type": "object",
      "required": ["timestamp_seconds", "kind", "observation"],
      "properties": {
        "timestamp_seconds": { "type": "number", "minimum": 0 },
        "kind": { "type": "string" },
        "observation": { "type": "string" },
        "transcript_quote": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "transcript_segment": {
      "type": "object",
      "required": ["start_seconds", "end_seconds", "text"],
      "properties": {
        "start_seconds": { "type": "number", "minimum": 0 },
        "end_seconds": { "type": "number", "minimum": 0 },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "required": ["text", "language", "segments"],
      "properties": {
        "text": { "type": "string" },
        "language": { "type": "string" },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/transcript_segment" }
        }
      },
      "additionalProperties": false
    },
    "property_score": {
      "type": "object",
      "required": ["property_id", "label", "score", "rationale", "confidence"],
      "properties": {
        "property_id": { "type": "string" },
        "label": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 10 },
        "rationale": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "required": ["priority", "title", "rationale", "action"],
      "properties": {
        "priority": { "type": "string" },
        "title": { "type": "string" },
        "rationale": { "type": "string" },
        "action": { "type": "string" }
      },
      "additionalProperties": false
    },
    "transcript_excerpt": {
      "type": "object",
      "required": ["start_seconds", "end_seconds", "text", "why_it_matters"],
      "properties": {
        "start_seconds": { "type": "number", "minimum": 0 },
        "end_seconds": { "type": "number", "minimum": 0 },
        "text": { "type": "string" },
        "why_it_matters": { "type": "string" }
      },
      "additionalProperties": false
    },
    "executed_skill_result": {
      "type": "object",
      "required": [
        "skill_id",
        "status",
        "evaluated_items",
        "summary",
        "skill_score",
        "property_scores",
        "detailed_assessment",
        "strengths",
        "improvement_opportunities",
        "recommendations",
        "key_signals",
        "evidence",
        "evidence_gaps",
        "transcript_excerpts",
        "warnings"
      ],
      "properties": {
        "skill_id": { "$ref": "#/$defs/analysis_skill_id" },
        "status": { "$ref": "#/$defs/executed_skill_status" },
        "evaluated_items": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": { "type": "string" },
        "skill_score": { "type": "number", "minimum": 0, "maximum": 10 },
        "property_scores": {
          "type": "array",
          "items": { "$ref": "#/$defs/property_score" }
        },
        "detailed_assessment": { "type": "string" },
        "strengths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "improvement_opportunities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommendations": {
          "type": "array",
          "items": { "$ref": "#/$defs/recommendation" }
        },
        "key_signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_item" }
        },
        "evidence_gaps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "transcript_excerpts": {
          "type": "array",
          "items": { "$ref": "#/$defs/transcript_excerpt" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "disclaimer": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
