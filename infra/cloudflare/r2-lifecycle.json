{
  "rules": [
    {
      "id": "expire-staging-after-24-hours",
      "enabled": true,
      "conditions": { "prefix": "staging/" },
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 86400 }
      }
    },
    {
      "id": "abort-incomplete-multipart-after-24-hours",
      "enabled": true,
      "conditions": { "prefix": "staging/" },
      "abortMultipartUploadsTransition": {
        "condition": { "type": "Age", "maxAge": 86400 }
      }
    }
  ]
}
